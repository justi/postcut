#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.1"

# Resolve symlink chain so installs via `ln -s ... /usr/local/bin/postcut`
# still find the lib/ next to the real script. macOS-friendly (no readlink -f).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$(dirname "$SOURCE")/$TARGET"
  fi
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# shellcheck source=../lib/core/cutoff.sh
source "$ROOT/lib/core/cutoff.sh"
# shellcheck source=../lib/core/github.sh
source "$ROOT/lib/core/github.sh"
# shellcheck source=../lib/core/router.sh
source "$ROOT/lib/core/router.sh"
# shellcheck source=../lib/core/save.sh
source "$ROOT/lib/core/save.sh"
# shellcheck source=../lib/adapters/ruby/parse.sh
source "$ROOT/lib/adapters/ruby/parse.sh"
# shellcheck source=../lib/adapters/ruby/fetch.sh
source "$ROOT/lib/adapters/ruby/fetch.sh"
# shellcheck source=../lib/adapters/ruby/local.sh
source "$ROOT/lib/adapters/ruby/local.sh"

usage() {
  cat <<'USAGE'
postcut — offline-prep dependency context for your LLM.

Run inside a project directory. Generates a markdown document per model
listing every gem that changed since that model's training cutoff —
written to `.postcut/<model>.md` so you can `cat` it into a chat session
later, even without internet.

USAGE:
  postcut [OPTIONS]

OPTIONS:
  --model NAME         Single model id from models.dev. Skips the global
                       models config. Default: claude-opus-4-7 if neither
                       --model nor a config file is present.
  --since YYYY-MM-DD   Override cutoff date (skips models.dev lookup).
                       Implies single-model run.
  --path DIR           Project directory (default: cwd).
  --all                Include transitive deps (default: direct deps from
                       Gemfile only — naturally dedupes Rails monorepo).
  --summary            Filter bullets to security/breaking/deprecation
                       only. Compact output for tight LLM context.
  --output PATH        Write to PATH instead of `.postcut/<model>.md`.
                       Only valid with a single model.
  --stdout             Emit to stdout instead of saving (legacy / pipe).
  --update             Pull the latest postcut into the install
                       directory ($ROOT) and exit. Refuses if it isn't
                       a git clone or has uncommitted changes.
  -h, --help           Show this help.
  -v, --version        Show version.

GLOBAL MODELS CONFIG:
  When neither --model nor --since is passed, postcut looks for a list
  of model ids at:

    <install_root>/.config/models

  One id per line, `#` for comments, blanks ignored. If present, postcut
  generates one document per listed model in `.postcut/`. Otherwise the
  default model is used.

Ruby only for now (Gemfile / Gemfile.lock). Set GITHUB_TOKEN to lift
the release-notes/advisories rate limit from 60/h to 5000/h.
USAGE
}

model_explicit=""
since=""
path="."
include_transitive=0
summary_only=0
output_path=""
mode_stdout=0
do_update=0

while [ $# -gt 0 ]; do
  case "$1" in
    --model)      model_explicit="$2"; shift 2 ;;
    --since)      since="$2"; shift 2 ;;
    --path)       path="$2"; shift 2 ;;
    --all)        include_transitive=1; shift ;;
    --summary)    summary_only=1; shift ;;
    --output)     output_path="$2"; shift 2 ;;
    --stdout)     mode_stdout=1; shift ;;
    --update)     do_update=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    -v|--version) echo "postcut $VERSION"; exit 0 ;;
    *)            echo "postcut: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --update is a self-update sink: pull the install dir to latest origin
# and exit. Refuses to coexist with delta-generation flags so a stray
# argument can't silently turn an update into a no-op run.
if [ "$do_update" -eq 1 ]; then
  if [ -n "$model_explicit" ] || [ -n "$since" ] || [ "$path" != "." ] \
     || [ "$include_transitive" -ne 0 ] || [ "$summary_only" -ne 0 ] \
     || [ -n "$output_path" ] || [ "$mode_stdout" -ne 0 ]; then
    echo "postcut: --update takes no other flags" >&2
    exit 2
  fi
  # Validate $ROOT is itself a worktree root (regular clone, linked
  # worktree, or submodule). `[ -d .git ]` would miss worktrees (.git is
  # a file) and `rev-parse --git-dir` alone would walk up to a parent
  # repo if the install happened to be nested inside one — and then we'd
  # operate on the wrong repo. Comparing show-toplevel to $ROOT pins us
  # to this directory specifically.
  toplevel=$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -z "$toplevel" ] || [ "$(cd "$toplevel" && pwd -P)" != "$(cd "$ROOT" && pwd -P)" ]; then
    echo "postcut: install at $ROOT is not a git worktree root — cannot --update" >&2
    echo "        re-run install.sh to switch to a git-managed install" >&2
    exit 1
  fi
  dirty=$(git -C "$ROOT" status --porcelain 2>/dev/null || true)
  if [ -n "$dirty" ]; then
    echo "postcut: $ROOT has uncommitted changes — refusing to --update" >&2
    printf '%s\n' "$dirty" >&2
    echo "        commit, stash, or revert them and re-run" >&2
    exit 1
  fi
  before=$(git -C "$ROOT" rev-parse --short HEAD)
  if ! git -C "$ROOT" symbolic-ref --quiet HEAD >/dev/null 2>&1; then
    echo "postcut: $ROOT is on a detached HEAD — re-run install.sh to" >&2
    echo "        switch to a tracked branch" >&2
    exit 1
  fi
  branch=$(git -C "$ROOT" symbolic-ref --short HEAD)
  # Fetch into FETCH_HEAD then merge --ff-only against THAT specific ref.
  # `git pull` would re-fetch internally, so a push between our explicit
  # fetch and the pull could land different commits than we just validated.
  # Surface git's stderr verbatim so transient failures (network, bad
  # remote URL, missing branch) aren't reduced to a single opaque line.
  fetch_err=$(git -C "$ROOT" fetch origin "$branch" 2>&1)
  fetch_status=$?
  if [ "$fetch_status" -ne 0 ]; then
    echo "postcut: git fetch failed for $branch" >&2
    [ -n "$fetch_err" ] && printf '%s\n' "$fetch_err" >&2
    echo "        check network and: git -C $ROOT remote get-url origin" >&2
    exit 1
  fi
  if ! git -C "$ROOT" merge --ff-only --quiet FETCH_HEAD 2>/dev/null; then
    echo "postcut: ff-only merge failed (local branch diverged from origin/$branch)" >&2
    exit 1
  fi
  after=$(git -C "$ROOT" rev-parse --short HEAD)
  if [ "$before" = "$after" ]; then
    echo "postcut: already up to date ($after)"
  else
    count=$(git -C "$ROOT" rev-list --count "$before..$after")
    echo "postcut: updated $before → $after ($count commit(s))"
  fi
  exit 0
fi

# Resolve absolute project path so ".postcut/" lands where the user
# expects regardless of cwd at exec time.
if [ ! -d "$path" ]; then
  echo "postcut: path '$path' is not a directory" >&2
  exit 2
fi
path=$(cd "$path" && pwd)

lockfile="$path/Gemfile.lock"
if [ ! -f "$lockfile" ]; then
  detected=""
  if [ -f "$path/package.json" ] || [ -f "$path/package-lock.json" ] \
     || [ -f "$path/yarn.lock" ] || [ -f "$path/pnpm-lock.yaml" ]; then
    detected="Node.js / npm"
  elif [ -f "$path/pyproject.toml" ] || [ -f "$path/poetry.lock" ] \
       || [ -f "$path/Pipfile.lock" ] || [ -f "$path/requirements.txt" ]; then
    detected="Python"
  elif [ -f "$path/Cargo.toml" ] || [ -f "$path/Cargo.lock" ]; then
    detected="Rust / cargo"
  elif [ -f "$path/go.mod" ] || [ -f "$path/go.sum" ]; then
    detected="Go"
  elif [ -f "$path/composer.json" ] || [ -f "$path/composer.lock" ]; then
    detected="PHP / composer"
  fi

  if [ -n "$detected" ]; then
    echo "postcut: $detected project detected in $path." >&2
    echo "v0.3 supports only Ruby (Gemfile.lock); $detected adapter is on the roadmap." >&2
  else
    echo "postcut: no Gemfile.lock in $path." >&2
    echo "v0.3 supports only Ruby projects. Multi-language adapters come later." >&2
  fi
  exit 1
fi

# Decide which models to process. Explicit --model pins to one; otherwise
# the global config is consulted; otherwise the default + a one-time
# hint so a first-run user knows where to put the config file.
# --since only overrides the cutoff date — every model in the loop uses
# it. POSTCUT_CONFIG_DIR overrides the install root for config lookup
# (used by the E2E test, harmless for normal runs).
config_dir="${POSTCUT_CONFIG_DIR:-$ROOT}"
config_file="$config_dir/.config/models"
models=()
if [ -n "$model_explicit" ]; then
  models=("$model_explicit")
else
  config_models=$(load_models_config "$config_dir")
  if [ -n "$config_models" ]; then
    while IFS= read -r m; do
      [ -n "$m" ] && models+=("$m")
    done <<< "$config_models"
  else
    # Distinguish "file is missing" from "file exists but every line
    # is empty or commented" — the installer seeds the latter shape, so
    # a fresh-install user sees a confusing "no models config" message
    # otherwise. Both empty files and all-comments files land here; the
    # message stays neutral about which.
    if [ -f "$config_file" ]; then
      echo "postcut: models config at $config_file has no active entries." >&2
      echo "         Using default 'claude-opus-4-7'. Add a model id (one" >&2
      echo "         per line, '#' for comments) to that file to include it." >&2
    else
      echo "postcut: no models config at $config_file" >&2
      echo "         using default 'claude-opus-4-7'. To snapshot multiple" >&2
      echo "         models in one run, create that file with one model id" >&2
      echo "         per line." >&2
    fi
    echo "         Suppress this hint with --model NAME." >&2
    models=("claude-opus-4-7")
  fi
fi

# Reject model IDs that would escape `.postcut/` or land in a missing
# subdirectory. Models on models.dev never contain slashes; if the user
# put one there it's almost certainly a mistake (or an attempt to abuse
# the save path), and silently truncating to basename would surprise.
for current_model in "${models[@]}"; do
  case "$current_model" in
    */* | *..* | "" | .*)
      echo "postcut: invalid model id '$current_model' — must not contain" >&2
      echo "         '/' or '..' and must not start with '.'" >&2
      echo "         (rejected for safety; check $config_file)" >&2
      exit 2
      ;;
  esac
done

# Hint when the local CVE database is stale. Runs once before the loop
# (the value is the same for every model) and is silent unless something
# is actually old. No-op when bundler-audit isn't installed.
ruby_check_advisory_db_freshness

if [ -n "$output_path" ] && [ "${#models[@]}" -gt 1 ]; then
  echo "postcut: --output requires a single model (got ${#models[@]})" >&2
  echo "        either pass --model NAME, or omit --output and let postcut" >&2
  echo "        write per-model files into .postcut/" >&2
  exit 2
fi

# --output and --stdout describe two different sinks; passing both would
# silently honor only --stdout (the file flag has no effect). Reject the
# combination explicitly so the user isn't left wondering where the file
# went.
if [ -n "$output_path" ] && [ "$mode_stdout" -eq 1 ]; then
  echo "postcut: --output and --stdout are mutually exclusive" >&2
  echo "        --stdout writes to stdout instead of saving; --output picks" >&2
  echo "        a save destination. Pick one." >&2
  exit 2
fi

# Compute filter scope (direct deps from Gemfile, unless --all).
gemfile="$path/Gemfile"
filter_regex=""
scope_label="all deps (Gemfile.lock)"
if [ "$include_transitive" -eq 0 ] && [ -f "$gemfile" ]; then
  direct=$(parse_gemfile "$gemfile")
  if [ -n "$direct" ]; then
    filter_regex="^($(printf '%s' "$direct" | tr '\n' '|' | sed 's/|$//'))$"
    direct_count=$(printf '%s\n' "$direct" | wc -l | tr -d ' ')
    scope_label="${direct_count} direct deps (Gemfile)"
  fi
fi

# Inner loop: per-model delta generation. Returns the (optionally
# summary-filtered) deltas string on stdout; the caller wraps it.
generate_deltas() {
  local cutoff="$1"
  local out=""
  local block=""
  while read -r name pin; do
    if [ -n "$filter_regex" ]; then
      [[ "$name" =~ $filter_regex ]] || continue
    fi
    block=$(fetch_ruby_delta "$name" "$cutoff" "$pin" 2>/dev/null) || block=""
    if [ -n "$block" ]; then
      out="${out}${block}"$'\n\n'
    fi
  done < <(parse_gemfile_lock "$lockfile")

  if [ "$summary_only" -eq 1 ] && [ -n "$out" ]; then
    # Keyword regex uses word-ish boundaries (start of line / non-letter
    # before, non-letter / EOL after) so substrings inside larger words
    # don't trigger — "nonbreaking" must not match "breaking", and
    # "discriminate" must not match "criminal" via "critical" pattern.
    # CVE-/GHSA- ids end with a hyphen-digit sequence and don't have
    # this issue.
    out=$(printf '%s' "$out" | awk '
      /^[^[:space:]]/ { print; next }
      /^[[:space:]]*$/ { print; next }
      /CVE-|GHSA-/ { print; next }
      /(^|[^[:alpha:]])([Ss]ecurity|[Bb]reaking|[Dd]eprecat(ed|ion|es|ing)?|CRITICAL|critical)([^[:alpha:]]|$)/ { print }
    ')
  fi

  printf '%s' "$out"
}

project_name=$(basename "$path")
save_dir=$(default_save_dir "$path")

if [ "$mode_stdout" -eq 0 ]; then
  # Defensive check: if `.postcut` already exists as a non-directory
  # (someone did `touch .postcut` by accident), `mkdir -p` would fail
  # with a raw, confusing message. Surface it with our prefix and a
  # clear remediation instead.
  if [ -e "$save_dir" ] && [ ! -d "$save_dir" ]; then
    echo "postcut: $save_dir exists but is not a directory" >&2
    echo "        remove it and re-run, or pass --output PATH to write" >&2
    echo "        somewhere else" >&2
    exit 2
  fi
  mkdir -p "$save_dir"
fi

for current_model in "${models[@]}"; do
  if [ -n "$since" ]; then
    cutoff="$since"
    cutoff_source="--since"
  else
    cutoff=$(resolve_cutoff "$current_model")
    cutoff_source="models.dev/$current_model"
  fi

  scope_suffix=""
  [ "$summary_only" -eq 1 ] && scope_suffix=", summary"

  deltas=$(generate_deltas "$cutoff")

  if [ "$mode_stdout" -eq 1 ]; then
    # Legacy plain-text output, one model only (the loop will print a
    # separator between models if a config produced multiple).
    if [ "${#models[@]}" -gt 1 ]; then
      printf '\n=== %s (cutoff: %s) ===\n\n' "$current_model" "$cutoff"
    fi
    echo "RECENT_DEPS_CHANGES (cutoff: $cutoff, source: $cutoff_source, scope: ${scope_label}${scope_suffix}):"
    if [ -z "${GITHUB_TOKEN:-}" ]; then
      echo "(set GITHUB_TOKEN to lift release-notes rate limit from 60/h → 5000/h)"
    fi
    echo
    if [ -z "$deltas" ]; then
      echo "(no post-cutoff updates in scope)"
    else
      printf '%s' "$deltas"
    fi
    continue
  fi

  # Save mode (default).
  if [ -n "$output_path" ]; then
    target="$output_path"
    mkdir -p "$(dirname "$target")"
  else
    target="${save_dir}/$(default_save_filename "$current_model")"
  fi

  format_markdown_doc \
    "$project_name" \
    "$current_model" \
    "$cutoff" \
    "$cutoff_source" \
    "${scope_label}${scope_suffix}" \
    "$deltas" \
    > "$target"

  # Brief stderr report so the user sees what happened.
  update_count=0
  [ -n "$deltas" ] && update_count=$(printf '%s\n' "$deltas" | grep -cE '^[a-zA-Z0-9_.-]+: .* \(current,' || true)
  printf 'postcut: wrote %s (%s, cutoff %s, %s update%s)\n' \
    "$target" "$current_model" "$cutoff" "$update_count" \
    "$([ "$update_count" = "1" ] && echo "" || echo "s")" >&2
done
